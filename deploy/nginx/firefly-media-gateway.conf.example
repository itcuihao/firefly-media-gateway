# Firefly Media Gateway - Host Nginx Reverse Proxy Example
#
# Usage on host (e.g., Ubuntu/Debian):
#   sudo cp deploy/nginx/firefly-media-gateway.conf.example /etc/nginx/sites-available/firefly-media-gateway.conf
#   # Replace `media.example.com` and verify Certbot SSL paths under /etc/letsencrypt/live/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Note: This file is NOT auto-applied by Docker deployment (`docker-compose.prod.yml`),
# because Nginx and Certbot SSL certificates live on the host OS.

server {
    server_name media.example.com;

    listen 443 ssl http2; # Use `listen 443 ssl;` + `http2 on;` on Nginx >= 1.25.1
    ssl_certificate /etc/letsencrypt/live/media.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/media.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Match the gateway's 2GB max video size and stream uploads directly without Nginx disk buffering
    client_max_body_size 2G;
    proxy_request_buffering off;

    # Media streaming & download (/media/ and /api/v1/media/*/stream)
    # Trust dynamic Cache-Control & CORS headers emitted by the Go gateway
    # (public -> max-age=31536000, immutable; private -> private, no-cache).
    location /media/ {
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable response buffering so Range video seeks and large downloads stream immediately
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Admin UI, upload API, S3 gateway, and other endpoints
    location / {
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen 80;
    server_name media.example.com;
    return 301 https://$host$request_uri;
}
